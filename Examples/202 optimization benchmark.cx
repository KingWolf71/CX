// 202 optimization benchmark.cx
// Targets specific optimization opportunities from TODO_OPTIMIZATIONS.md
// Each test isolates ONE bottleneck so we can measure before/after
// V1.114.65

#pragma appname "Optimization-Benchmark"
#pragma console on
#pragma ListASM off
#pragma FastPrint on
#pragma ftoi "truncate"
#pragma modulename on
#pragma GlobalStack 1024
#pragma FunctionStack 256
#pragma EvalStack 256
#pragma LocalStack 256
#pragma asmdecimal on

// ============================================================================
// Global storage for results (no print in hot paths)
// ============================================================================
ITERS = 100000;

t0.i = 0;
t1.i = 0;
res.i = 0;

// Global array for tests
array gArr.i[1000];
gSum.i = 0;

// Struct definitions for test 5
struct Point {
    x.i;
    y.i;
}

struct Rect {
    topLeft.Point;
    bottomRight.Point;
}

struct Layout {
    bounds.Rect;
    padding.i;
}

// ============================================================================
// TEST 1: Lazy Local Cleanup (Optimization #1)
// Leaf function with ONLY int locals - cleanup should be skippable
// Measures overhead of cleaning up locals that were never dirty
// ============================================================================
func leafIntOnly(a.i, b.i) {
    c.i = a + b;
    d.i = c * 2;
    e.i = d - a;
    f.i = e + 1;
    return f;
}

func benchLeafCleanup() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + leafIntOnly(i, i + 1);
    }
    return sum;
}

// ============================================================================
// TEST 2: CopyStructure Per Local (Optimization #2)
// Function with MANY locals - each gets CopyStructure on entry
// ============================================================================
func manyLocals(n.i) {
    a.i = n;
    b.i = n + 1;
    c.i = n + 2;
    d.i = n + 3;
    e.i = n + 4;
    f.i = n + 5;
    g.i = n + 6;
    h.i = n + 7;
    j.i = n + 8;
    k.i = n + 9;
    return a + b + c + d + e + f + g + h + j + k;
}

func benchManyLocals() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + manyLocals(i);
    }
    return sum;
}

// ============================================================================
// TEST 3: Field-by-Field Parameter Copy (Optimization #3)
// Function with MANY parameters - each copied field by field
// ============================================================================
func manyParams(a.i, b.i, c.i, d.i, e.i) {
    return a + b + c + d + e;
}

func benchManyParams() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + manyParams(i, i+1, i+2, i+3, i+4);
    }
    return sum;
}

// ============================================================================
// TEST 4: ReDim Local Arrays (Optimization #4)
// Function with local array - ReDim on every call
// ============================================================================
func localArray(n.i) {
    array la.i[10];
    la[0] = n;
    la[1] = n + 1;
    la[2] = n + 2;
    return la[0] + la[1] + la[2];
}

func benchLocalArray() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + localArray(i);
    }
    return sum;
}

// ============================================================================
// TEST 5: Struct Field Access (Optimization #5)
// Nested struct field access - walks hierarchy each time
// ============================================================================
func benchStructAccess() {
    lay.Layout;
    lay\bounds\topLeft\x = 10;
    lay\bounds\topLeft\y = 20;
    lay\bounds\bottomRight\x = 30;
    lay\bounds\bottomRight\y = 40;
    lay\padding = 5;
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + lay\bounds\topLeft\x;
        sum = sum + lay\bounds\topLeft\y;
        sum = sum + lay\bounds\bottomRight\x;
        sum = sum + lay\bounds\bottomRight\y;
        sum = sum + lay\padding;
    }
    return sum;
}

// ============================================================================
// TEST 6: Multiply vs Shift (Optimization #9)
// Power-of-2 multiplies that could be bit shifts
// ============================================================================
func benchMultiply2() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        a.i = i * 2;
        b.i = a * 4;
        c.i = b * 8;
        sum = sum + c;
    }
    return sum;
}

// ============================================================================
// TEST 7: Loop Invariant (Optimization #10)
// len() called every iteration - should be hoisted
// ============================================================================
func benchLoopInvariant() {
    s.s = "Hello World Test String For Length";
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = sum + len(s);
    }
    return sum;
}

// ============================================================================
// TEST 8: Deep Recursion (Optimization #7 - Frame Pool)
// Recursive function that exhausts frame pool
// ============================================================================
func recurse(n.i) {
    if (n <= 0) { return 0; }
    return n + recurse(n - 1);
}

func benchRecursion() {
    sum.i = 0;
    for (i = 0; i < 1000; i++) {
        sum = sum + recurse(100);
    }
    return sum;
}

// ============================================================================
// TEST 9: Function Call Overhead Baseline
// Minimal function - isolates pure call/return cost
// ============================================================================
func noop(x.i) {
    return x;
}

func benchCallOverhead() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        sum = noop(sum) + 1;
    }
    return sum;
}

// ============================================================================
// TEST 10: Dead Stores (Optimization #11)
// Assignments overwritten before being read
// ============================================================================
func benchDeadStores() {
    sum.i = 0;
    for (i = 0; i < ITERS; i++) {
        a.i = i * 3;
        a = i * 5;
        a = i * 7;
        sum = sum + a;
    }
    return sum;
}

// ============================================================================
// RUN ALL BENCHMARKS WITH INDIVIDUAL TIMING
// ============================================================================
print("================================================================");
print("  OPTIMIZATION BENCHMARK v1.0");
print("  Targets: TODO_OPTIMIZATIONS.md items #1-#11");
printf("  Iterations: %d\n", ITERS);
print("================================================================");
print("");

// --- Test 1: Leaf cleanup ---
t0 = elapsed();
res = benchLeafCleanup();
t1 = elapsed();
printf("  #1 Leaf cleanup (int-only locals):  %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 2: Many locals ---
t0 = elapsed();
res = benchManyLocals();
t1 = elapsed();
printf("  #2 Many locals (10 vars init):      %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 3: Many params ---
t0 = elapsed();
res = benchManyParams();
t1 = elapsed();
printf("  #3 Many params (5 params copy):     %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 4: Local arrays ---
t0 = elapsed();
res = benchLocalArray();
t1 = elapsed();
printf("  #4 Local arrays (ReDim per call):   %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 5: Struct access ---
t0 = elapsed();
res = benchStructAccess();
t1 = elapsed();
printf("  #5 Struct field access (nested):    %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 6: Multiply (shift candidate) ---
t0 = elapsed();
res = benchMultiply2();
t1 = elapsed();
printf("  #6 Multiply x2/x4/x8 (shift):      %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 7: Loop invariant ---
t0 = elapsed();
res = benchLoopInvariant();
t1 = elapsed();
printf("  #7 Loop invariant (len in loop):    %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 8: Deep recursion ---
t0 = elapsed();
res = benchRecursion();
t1 = elapsed();
printf("  #8 Recursion (depth 100 x 1000):    %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 9: Call overhead ---
t0 = elapsed();
res = benchCallOverhead();
t1 = elapsed();
printf("  #9 Call overhead (minimal func):    %d ms  [res=%d]\n", t1 - t0, res);

// --- Test 10: Dead stores ---
t0 = elapsed();
res = benchDeadStores();
t1 = elapsed();
printf("  #10 Dead stores (overwritten vars): %d ms  [res=%d]\n", t1 - t0, res);

print("");
print("================================================================");
print("  INTERPRETATION GUIDE:");
print("  #1,#2,#9 = Function call/return overhead (opts 1,2)");
print("  #3       = Parameter passing overhead (opt 3)");
print("  #4       = Local array allocation overhead (opt 4)");
print("  #5       = Struct hierarchy walk (opt 5, codegen)");
print("  #6       = Strength reduction opportunity (opt 9)");
print("  #7       = Loop invariant hoisting (opt 10)");
print("  #8       = Frame pool sizing (opt 7)");
print("  #10      = Dead store elimination (opt 11)");
print("================================================================");
